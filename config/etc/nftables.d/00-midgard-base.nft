# Holds every order-sensitive rule. Other drop-ins only add set elements or
# rules in the *-dropins chains, so their file order cannot bypass these.

table inet midgard-filter {
    # Matched for host ports and published container ports alike.
    # Elements look like `tcp . 22` or `udp . 27031-27036`.
    set midgard-open {
        type inet_proto . inet_service
        flags interval
    }

    # Wins over midgard-open, for host and container ports.
    set midgard-blocked {
        type inet_proto . inet_service
        flags interval
    }

    chain midgard-prerouting {
        # Before conntrack and DNAT: sees the original port, covers forwarded
        # traffic too, and cuts established connections.
        type filter hook prerouting priority raw; policy accept;

        meta l4proto . th dport @midgard-blocked jump midgard-log-blocked
        meta l4proto . th dport @midgard-blocked counter drop
    }

    chain midgard-input {
        type filter hook input priority filter; policy drop;

        ct state vmap {
            invalid : drop,
            established : accept,
            related : accept
        }
        iif lo accept

        meta l4proto { icmp, ipv6-icmp } accept

        # Replies to multicast requests; conntrack does not see them as related.
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        udp dport 5353 ip daddr 224.0.0.251 accept
        udp dport 5353 ip6 daddr ff02::fb accept

        meta l4proto . th dport @midgard-open accept

        jump midgard-input-dropins
        jump midgard-log-input

        # Rate-limited so we cannot be used to flood errors; the rest, plus
        # broadcast and multicast, falls through to the silent drop.
        pkttype host limit rate 5/second counter reject with icmpx type admin-prohibited
        # The policy has no counter of its own.
        counter
    }

    # Published ports of rootful podman are DNATed here and never reach input.
    chain midgard-forward {
        # A drop is final across chains, so this also overrides netavark's accepts.
        type filter hook forward priority filter; policy drop;

        ct state vmap {
            invalid : drop,
            established : accept,
            related : accept
        }
        iifname "podman*" accept

        # Match the port as originally addressed, before DNAT rewrote it.
        oifname "podman*" ct status dnat meta l4proto . ct original proto-dst @midgard-open accept

        jump midgard-forward-dropins
        jump midgard-log-forward

        counter
    }

    # Drop-ins append here; the jumps above fix where they run.
    chain midgard-input-dropins {
    }

    # Addresses here are already rewritten by DNAT.
    chain midgard-forward-dropins {
    }

    # Filled at runtime by the firewall-log-on task; any reload empties them.
    chain midgard-log-input {
    }

    chain midgard-log-forward {
    }

    chain midgard-log-blocked {
    }
}
